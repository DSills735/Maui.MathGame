<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.MathGame.MainPage">

    <ContentView>
        <VerticalStackLayout Spacing ="25" Padding="50" >
            
            <Label Text="Welcome to the Math Game!" />
            <Label Text="What game do you want to play?" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" 
                        Text="Addition"
                        Clicked="OnGameChosen"/>
                
                <Button Grid.Column="1" 
                        Text="Subtraction"
                        Clicked="OnGameChosen"/>
                
                <Button Grid.Column="2" 
                        Text="Multiplication"
                        Clicked="OnGameChosen"/>
                
                <Button Grid.Column="3" 
                        Text="Division"
                        Clicked="OnGameChosen"/>
                
                <Button Grid.Row="1" 
                        Grid.ColumnSpan="4" 
                        BackgroundColor="Aquamarine"
                        Text="View Previous Games"
                        Clicked="OnViewPreviousGameChosen"
                />
            </Grid>
        </VerticalStackLayout>
    </ContentView>
</ContentPage>
